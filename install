#!/bin/sh

# Setup script for image-builder-frontend bare repo
# Run this after cloning with: git clone --bare --origin=upstream <url>

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BARE_REPO="$(dirname "$SCRIPT_DIR")"

echo "Setting up bare repo at: $BARE_REPO"

cd "$BARE_REPO"

# Ensure we're in a bare repo
if [ "$(git rev-parse --is-bare-repository)" != "true" ]; then
    echo "Error: This doesn't appear to be a bare repository"
    exit 1
fi

# Fix upstream remote fetch refspec if missing
echo "==> Configuring upstream remote..."
if ! git config --get remote.upstream.fetch >/dev/null 2>&1; then
    git config remote.upstream.fetch '+refs/heads/*:refs/remotes/upstream/*'
    echo "    Added fetch refspec for upstream"
else
    echo "    Fetch refspec already configured"
fi

# Add kingsley remote if it doesn't exist
echo "==> Configuring kingsley remote..."
if ! git remote get-url kingsley >/dev/null 2>&1; then
    git remote add kingsley git@github.com:kingsleyzissou/image-builder-frontend.git
    echo "    Added kingsley remote"
else
    echo "    kingsley remote already exists"
fi

# Ensure kingsley has fetch refspec
if ! git config --get remote.kingsley.fetch >/dev/null 2>&1; then
    git config remote.kingsley.fetch '+refs/heads/*:refs/remotes/kingsley/*'
    echo "    Added fetch refspec for kingsley"
fi

# Fetch from remotes
echo "==> Fetching from remotes..."
git fetch upstream
git fetch kingsley

# Install hooks
echo "==> Installing hooks..."
if [ -d "$SCRIPT_DIR/hooks" ]; then
    for hook in "$SCRIPT_DIR/hooks"/*; do
        if [ -f "$hook" ]; then
            hookname="$(basename "$hook")"
            cp "$hook" "$BARE_REPO/hooks/$hookname"
            chmod +x "$BARE_REPO/hooks/$hookname"
            echo "    Installed $hookname"
        fi
    done
else
    echo "    No hooks directory found"
fi

# Create main worktree if it doesn't exist
echo "==> Setting up main worktree..."
if [ -d "$BARE_REPO/main" ]; then
    echo "    main worktree already exists"
else
    git worktree add main upstream/main
    echo "    Created main worktree"
fi

# Allow direnv for the bare repo
echo "==> Configuring direnv..."
if [ -f "$SCRIPT_DIR/.envrc" ]; then
    cp "$SCRIPT_DIR/.envrc" "$BARE_REPO/.envrc"
    direnv allow "$BARE_REPO"
    echo "    direnv configured and allowed"
else
    echo "    No .envrc found"
fi

echo ""
echo "Setup complete!"
echo ""
echo "Next steps:"
echo "  cd main && npm ci"
echo ""
echo "To create a new feature branch worktree:"
echo "  git worktree add <name> -b <branch-name>"
echo ""
