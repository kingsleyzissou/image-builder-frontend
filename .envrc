# direnv config for image-builder-frontend bare repo
# This runs sanity checks when entering the bare repo directory

# Inherit parent .envrc files
source_up

# Check if this is actually a bare repo
if [ "$(git rev-parse --is-bare-repository 2>/dev/null)" != "true" ]; then
    return
fi

# Check for pre-commit hook
if [ ! -x "hooks/pre-commit" ]; then
    echo "Warning: pre-commit hook not installed"
    echo "  Run: ./setup/install"
fi

# Check upstream fetch refspec
if ! git config --get remote.upstream.fetch >/dev/null 2>&1; then
    echo "Warning: upstream remote missing fetch refspec"
    echo "  Run: ./setup/install"
fi
